pipeline {
    agent none
    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }
    // No incoming webhook or public controller port is needed.
    triggers { cron('H/2 * * * *') }
    stages {
        stage('Find published release') {
            agent { label 'linux' }
            steps {
                dir('ci-release-monitor') {
                    deleteDir()
                    checkout scm
                    withCredentials([string(credentialsId: 'github-release-token', variable: 'GITHUB_TOKEN')]) {
                        script {
                            env.PENDING_RELEASE = sh(returnStdout: true, script: '''
                                set +x
                                python3 scripts/github_release.py pending
                            ''').trim()
                            echo env.PENDING_RELEASE ? "Release to build: ${env.PENDING_RELEASE}" : 'All published releases have packages'
                        }
                    }
                }
            }
        }
        stage('Build and publish release') {
            when { expression { return env.PENDING_RELEASE } }
            // Release the single Linux executor before waiting for the downstream matrix.
            steps {
                build job: 'desktop-pdf-translator', wait: true, propagate: true,
                      parameters: [string(name: 'RELEASE_TAG', value: env.PENDING_RELEASE)]
            }
        }
    }
}
